---
layout: base.njk
noSubscribe: true
---
{% from "macros.njk" import catTag, fmtTag %}
{% set L = i18n[pageLang] %}
{% set catLabel = site.categories[category][pageLang] %}
{% set fmtLabels = {
  texto:{pt:"Texto",es:"Texto",en:"Text"},
  pdf:{pt:"PDF",es:"PDF",en:"PDF"},
  video:{pt:"Vídeo",es:"Video",en:"Video"},
  imagem:{pt:"Imagens",es:"Imágenes",en:"Images"}
} %}

<article class="post">
  {{ catTag(category, catLabel, page.date | shortdate(pageLang)) }}
  <h1>{{ title }}</h1>
  <p class="post-meta">{{ fmtLabels[format][pageLang] }}{% if format=="video" %} · {{ L.captions }}{% elif format=="imagem" %} · {{ L.described }}{% endif %}</p>

  {% if format=="video" and video %}
    <div class="embed"><iframe src="{{ video }}" title="{{ title }}" loading="lazy" allowfullscreen></iframe></div>
    {% if transcript %}<details class="transcript"><summary>{{ L.transcript }}</summary><div>{{ transcript | safe }}</div></details>{% endif %}
  {% endif %}

  {% if format=="pdf" and pdf %}
    <object class="pdf-frame" data="{{ pdf | url }}" type="application/pdf" aria-label="{{ title }}">
      <p><a class="readmore" href="{{ pdf | url }}">{{ L.readmore }} (PDF)</a></p>
    </object>
    <p class="dl"><a class="readmore" href="{{ pdf | url }}" download>↓ PDF</a></p>
  {% endif %}

  {% if format=="imagem" and gallery %}
    <div class="gallery">
      {% for img in gallery %}
      <figure><img src="{{ img.src | url }}" alt="{{ img.alt }}" loading="lazy">{% if img.caption %}<figcaption>{{ img.caption }}</figcaption>{% endif %}</figure>
      {% endfor %}
    </div>
  {% endif %}

  <div class="body">{{ content | safe }}</div>

  {% if abnt %}
  <div class="abnt"><span class="lbl">{{ L.abnt_label }}</span><p>{{ abnt | safe }}</p></div>
  {% endif %}

  {% set rl = reactions.labels[pageLang] %}
  <section class="reactions" data-slug="{{ page.fileSlug }}" aria-labelledby="rxq">
    <div class="q" id="rxq">{{ rl.q }}</div>
    <p class="hint">{{ rl.hint }}</p>
    <div class="rx-grid">
      {% for r in reactions.items %}
      <button class="rx" type="button" data-k="{{ r.key }}" style="--rc:{{ r.color }}" aria-pressed="false"
        title="{{ rl[r.key][0] }} — {{ rl[r.key][1] }}" aria-label="{{ rl[r.key][0] }}: {{ rl[r.key][1] }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true">{{ r.svg | safe }}</svg>
        <span class="lbl">{{ rl[r.key][0] }}</span>
        <span class="mean">{{ rl[r.key][1] }}</span>
        <span class="cnt" data-count>0</span>
      </button>
      {% endfor %}
    </div>
  </section>

  {% include "subscribe.njk" %}

  <!-- COMENTÁRIOS (com aprovação) -->
  <section class="comments" data-slug="{{ page.fileSlug }}"
    data-msg-pending="{{ L.c_pending }}" data-msg-off="{{ L.c_off }}" data-msg-err="{{ L.c_err }}" data-msg-none="{{ L.c_none }}"
    aria-labelledby="ch">
    <h2 id="ch">{{ L.c_title }}</h2>
    <p class="sub">{{ L.c_sub }}</p>
    <div class="clist" data-clist>
      <p class="c-empty eyebrow" data-cempty>{{ L.c_none }}</p>
    </div>
    <form class="cform" data-cform novalidate>
      <div class="grid2">
        <div class="field">
          <label for="cname">{{ L.c_name }} <span class="opt">{{ L.c_opt }}</span></label>
          <input id="cname" name="name" type="text" autocomplete="off" maxlength="80">
        </div>
        <div class="field">
          <label for="cid">{{ L.c_id }} <span class="opt">{{ L.c_vol }}</span></label>
          <input id="cid" name="ident" type="text" autocomplete="off" maxlength="80" placeholder="ex.: ela/dela · profissão · localidade">
        </div>
      </div>
      <p class="idhelp">{{ L.c_idhelp }}</p>
      <!-- campo-armadilha anti-robô (fica escondido) -->
      <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <div class="field">
        <label for="ctext">{{ L.c_text }}</label>
        <textarea id="ctext" name="text" maxlength="3000" required></textarea>
      </div>
      <button type="submit">{{ L.c_send }}</button>
      <p class="c-msg" data-cmsg role="status" aria-live="polite"></p>
    </form>
  </section>

  <!-- CONTINUAR LENDO -->
  {% set rel = collections["posts_" + pageLang] | related(page.url, category, 3) %}
  {% if rel.length %}
  {% set fmtLabels2 = { texto:{pt:"Texto",es:"Texto",en:"Text"}, pdf:{pt:"PDF",es:"PDF",en:"PDF"}, video:{pt:"Vídeo",es:"Video",en:"Video"}, imagem:{pt:"Imagens",es:"Imágenes",en:"Images"} } %}
  <section class="related" aria-labelledby="rh">
    <div class="recent-head"><h3 id="rh">{{ L.related }}</h3></div>
    <div class="grid">
      {% for post in rel %}
      <article class="card" tabindex="0">
        {{ catTag(post.data.category, site.categories[post.data.category][pageLang], post.date | shortdate(pageLang)) }}
        <h4><a href="{{ post.url | url }}">{{ post.data.title }}</a></h4>
        <p>{{ post.data.excerpt }}</p>
        <div class="foot">{{ fmtTag(post.data.format, fmtLabels2[post.data.format][pageLang]) }}</div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <a class="backlink" href="{{ L.home | url }}">← {{ site.title }}</a>
</article>
