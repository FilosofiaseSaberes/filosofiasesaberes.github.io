{% from "macros.njk" import catTag, fmtTag %}
{% set L = i18n[pageLang] %}
{% set posts = collections["posts_" + pageLang] %}
{% set fmtLabels = {
  texto:{pt:"Texto",es:"Texto",en:"Text"},
  pdf:{pt:"PDF",es:"PDF",en:"PDF"},
  video:{pt:"Vídeo · " + L.captions, es:"Video · " + L.captions, en:"Video · " + L.captions},
  imagem:{pt:"Imagens · " + L.described, es:"Imágenes · " + L.described, en:"Images · " + L.described}
} %}

<p class="issue-line eyebrow">{{ L.tagline }}</p>

{% if posts and posts.length %}
{% set feat = posts[0] %}
<section class="featured" aria-labelledby="featTitle">
  <div class="plate">
    <svg viewBox="0 0 200 200" role="img" aria-label="Motivo cósmico">
      <circle cx="100" cy="100" r="30" fill="none" stroke="#E4B84E" stroke-width="2"/><circle cx="100" cy="100" r="9" fill="#E4B84E"/>
      <g stroke="#E4B84E" stroke-width="2" stroke-linecap="round"><line x1="100" y1="40" x2="100" y2="58"/><line x1="100" y1="142" x2="100" y2="160"/><line x1="40" y1="100" x2="58" y2="100"/><line x1="142" y1="100" x2="160" y2="100"/><line x1="58" y1="58" x2="70" y2="70"/><line x1="142" y1="58" x2="130" y2="70"/><line x1="58" y1="142" x2="70" y2="130"/><line x1="142" y1="142" x2="130" y2="130"/></g>
      <path d="M40 168 Q100 150 160 168" fill="none" stroke="#3FBFB4" stroke-width="2"/><path d="M40 24 Q100 42 160 24" fill="none" stroke="#3FBFB4" stroke-width="2"/>
    </svg>
  </div>
  <div>
    {{ catTag(feat.data.category, site.categories[feat.data.category][pageLang], feat.date | shortdate(pageLang)) }}
    <h2 id="featTitle"><a href="{{ feat.url | url }}">{{ feat.data.title }}</a></h2>
    <p class="lede">{{ feat.data.excerpt }}</p>
    {% if feat.data.abnt %}<div class="abnt"><span class="lbl">{{ L.abnt_label }}</span><p>{{ feat.data.abnt | safe }}</p></div>{% endif %}
    <div class="meta">{{ fmtTag(feat.data.format, fmtLabels[feat.data.format][pageLang]) }}<a class="readmore" href="{{ feat.url | url }}">{{ L.readmore }}</a></div>
  </div>
</section>

<div class="recent-head"><h3>{{ L.recent }}</h3><span class="eyebrow">{{ L.index }}</span></div>
<div class="grid">
  {% for post in posts %}
    {% if loop.index > 1 %}
    <article class="card" tabindex="0">
      {{ catTag(post.data.category, site.categories[post.data.category][pageLang], post.date | shortdate(pageLang)) }}
      <h4><a href="{{ post.url | url }}">{{ post.data.title }}</a></h4>
      <p>{{ post.data.excerpt }}</p>
      <div class="foot">{{ fmtTag(post.data.format, fmtLabels[post.data.format][pageLang]) }}</div>
    </article>
    {% endif %}
  {% endfor %}
</div>
{% else %}
<p class="issue-line eyebrow" style="border:none">— sem publicações neste idioma ainda —</p>
{% endif %}
